# Frontend (Vite / Netlify)
# Local dev: leave empty — Vite proxies /api → http://localhost:5000
# Production: set to your deployed backend URL (no trailing slash)
# Example: https://mogadishu-furniture-api.onrender.com
VITE_API_URL=

# Google Sign-In (OAuth 2.0 Web Client ID from Google Cloud Console)
# Create at: https://console.cloud.google.com/apis/credentials
# Authorized JavaScript origins: http://localhost:5173 and your live site
# Use the SAME Client ID in backend GOOGLE_CLIENT_ID
VITE_GOOGLE_CLIENT_ID=
