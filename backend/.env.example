MONGODB_URI=your_mongodb_atlas_connection_string
JWT_SECRET=your_jwt_secret

# Waafi Pay (keep secret — never commit .env)
WAAFI_API_URL=https://api.waafipay.net/asm
WAAFI_MERCHANT_UID=M0910291
WAAFI_API_USER_ID=1000416
WAAFI_API_KEY=your_waafi_api_key

# Gmail / SMTP for welcome & password reset emails
# For Gmail: use App Password (Google Account → Security → 2-Step → App passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM=your_gmail@gmail.com

# SMS for password reset (Twilio or generic gateway)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Or custom SMS API:
SMS_API_URL=
SMS_API_KEY=
